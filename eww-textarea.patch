+const WIDGET_NAME_TEXTAREA: &str = "textarea";
+/// @widget textarea
+/// @desc A multi-line text field: Enter starts a new line, Ctrl+Enter runs `onaccept`. Put it in a `scroll` for long texts. Commands get the text on their stdin; `{}` is replaced by it as well, but multi-line text is rarely safe in a command line. Style it with the `textview` and `textview text` css nodes. For this to be useful, set `focusable="true"` on the window.
+fn build_gtk_textarea(bargs: &mut BuilderArgs) -> Result<gtk::TextView> {
+    let gtk_widget = gtk::TextView::new();
+    def_widget!(bargs, _g, gtk_widget, {
+        // @prop value - the text. Setting the text that is already there does nothing (the cursor stays where it is)
+        prop(value: as_string) {
+            let buffer = gtk_widget.buffer().context("textarea without a text buffer")?;
+            if text_buffer_text(&buffer) != value {
+                buffer.set_text(&value);
+            }
+        },
+        // @prop onchange - Command to run when the text changes. The text is on its stdin
+        // @prop timeout - timeout of the command. Default: "200ms"
+        prop(timeout: as_duration = Duration::from_millis(200), onchange: as_string) {
+            let buffer = gtk_widget.buffer().context("textarea without a text buffer")?;
+            connect_signal_handler!(buffer, buffer.connect_changed(move |buffer| {
+                let text = text_buffer_text(buffer);
+                run_command_with_input(timeout, &onchange, &[text.clone()], text);
+            }));
+        },
+        // @prop onaccept - Command to run on Ctrl+Enter. The text is on its stdin
+        // @prop timeout - timeout of the command. Default: "200ms"
+        prop(timeout: as_duration = Duration::from_millis(200), onaccept: as_string) {
+            connect_signal_handler!(gtk_widget, gtk_widget.connect_key_press_event(move |gtk_widget, evt| {
+                let enter = evt.keyval() == gdk::keys::constants::Return || evt.keyval() == gdk::keys::constants::KP_Enter;
+                if !enter || !evt.state().contains(ModifierType::CONTROL_MASK) {
+                    return glib::Propagation::Proceed;
+                }
+                if let Some(buffer) = gtk_widget.buffer() {
+                    let text = text_buffer_text(&buffer);
+                    run_command_with_input(timeout, &onaccept, &[text.clone()], text);
+                }
+                glib::Propagation::Stop
+            }));
+        },
+        // @prop wrap-mode - how lines are wrapped. possible options: $wrap_mode. Default: "wordchar"
+        prop(wrap_mode: as_string = "wordchar") {
+            gtk_widget.set_wrap_mode(parse_text_wrap_mode(&wrap_mode)?);
+        },
+        // @prop editable - whether the text can be changed (it can always be selected and copied). Default: true
+        prop(editable: as_bool = true) {
+            gtk_widget.set_editable(editable);
+            gtk_widget.set_cursor_visible(editable);
+        }
+    });
+    Ok(gtk_widget)
+}
+
+/// The whole text of a text buffer.
+fn text_buffer_text(buffer: &gtk::TextBuffer) -> String {
+    let (start, end) = buffer.bounds();
+    buffer.text(&start, &end, true).map(|text| text.to_string()).unwrap_or_default()
+}
