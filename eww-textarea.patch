 /// @var wrap_mode - "word", "char", "wordchar"
+fn parse_text_wrap_mode(w: &str) -> Result<gtk::WrapMode> {
+    enum_parse! { "wrap-mode", w,
+        "none" => gtk::WrapMode::None,
+        "word" => gtk::WrapMode::Word,
+        "char" => gtk::WrapMode::Char,
+        "wordchar" => gtk::WrapMode::WordChar
+    }
+}
